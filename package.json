{
  "name": "kasirpro",
  "version": "1.0.0",
  "private": true,
  "description": "KasirPro — PWA Portal Operator (Vercel)",
  "license": "UNLICIPED",
  "scripts": {
    "setup": "npm run install:portal",
    "install:portal": "npm --prefix ./portal install",
    "dev:portal": "npm --prefix ./portal run dev",
    "build:portal": "npm --prefix ./portal run build",
    "start:portal": "npm --prefix ./portal run start",
    "deploy": "vercel deploy --prod --yes",
    "deploy:preview": "vercel deploy --yes",
    "typecheck": "npm --prefix ./portal run typecheck",
    "test": "node tools/test/run-all.mjs",
    "test:statis": "node tools/test/run-all.mjs statis",
    "test:portal": "node tools/test/run-all.mjs portal"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
