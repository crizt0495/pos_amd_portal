{
  "name": "kasirpro",
  "version": "1.0.0",
  "private": true,
  "description": "KasirPro - Sistem Aktivasi Berbasis Hardware ID. POS Kasir Fullstack Offline-First.",
  "author": "KasirPro",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:standalone": "next build && node scripts/prepare-standalone.mjs",
    "electron:dev": "concurrently -k -n NEXT,ELECTRON -c cyan,magenta \"npm run dev\" \"npm run electron:start\"",
    "electron:start": "wait-on http://localhost:3000 && electron .",
    "electron:build": "npm run build:standalone && electron-builder --win --x64 --publish never",
    "build:exe": "npm run electron:build",
    "build:win": "npm run electron:build",
    "build:linux": "npm run build:standalone && electron-builder --linux AppImage --publish never",
    "postinstall": "node scripts/postinstall.js",
    "supabase:types": "node scripts/gen-types.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.2.0",
    "lucide-react": "^0.475.0",
    "next": "14.2.35",
    "node-machine-id": "^1.1.12",
    "node-thermal-printer": "^4.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.kasirpro.app",
    "productName": "KasirPro",
    "copyright": "Copyright © 2026 KasirPro",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "node_modules/node-machine-id/**/*",
      "node_modules/node-thermal-printer/**/*",
      "node_modules/iconv-lite/**/*",
      "node_modules/safer-buffer/**/*",
      "node_modules/pngjs/**/*",
      "node_modules/unorm/**/*",
      "node_modules/write-file-queue/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env.production",
        "to": ".env.production",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KasirPro"
    },
    "portable": {
      "artifactName": "KasirPro-Setup.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "asarUnpack": [
      "**/node_modules/node-machine-id/**",
      "**/node_modules/node-thermal-printer/**"
    ]
  }
}
