{
  "name": "kasirpro-desktop",
  "productName": "KasirPro",
  "version": "1.0.0",
  "private": true,
  "description": "KasirPro Desktop — Aplikasi Kasir Electron 100% offline untuk pembeli akhir",
  "author": "KasirPro",
  "homepage": "https://github.com/crizt0495/pos_amd",
  "license": "UNLICIPED",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5273 && cross-env KASIRPRO_DEV=1 electron .",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "set-portal": "node scripts/set-portal.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:win": "npm run dist",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --win --mac --linux"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.17.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.kasirpro.kasir",
    "productName": "KasirPro",
    "copyright": "Copyright © 2026 KasirPro",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "KasirPro-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KasirPro",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "KasirPro-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "artifactName": "KasirPro-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "KasirPro ${version}",
      "artifactName": "KasirPro-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "executableName": "kasirpro",
      "maintainer": "KasirPro <admin@kasirpro.id>",
      "artifactName": "KasirPro-${version}-${arch}.${ext}"
    }
  }
}
