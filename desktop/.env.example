# ---------------------------------------------------------------------------
# KasirPro Desktop — environment variables
# Salin:  cp .env.example .env   (file .env sudah masuk .gitignore)
# ---------------------------------------------------------------------------

# URL portal yang berisi endpoint aktivasi.
# WAJIB diisi domain Vercel Anda yang sudah online (https://.../api/activate).
# Dipakai hanya saat aktivasi pertama (butuh internet 1x).
PORTAL_VERCEL_URL=https://kasirpro-portal.vercel.app

# Alias (boleh dipakai kalau lebih nyaman): VITE_API_URL
# VITE_API_URL=https://kasirpro-portal.vercel.app

# Cara paling aman untuk rilis (tidak butuh .env di paket):
#     npm run set-portal -- https://domain-anda.vercel.app
#     npm run dist:win
# Perintah itu menulis electron/build-config.json yang ikut terpack ke .exe.

# Opsional — ganti nama toko / alamat / telepon / nama kasir default.
# Bisa juga diubah dari menu aplikasi.
# STORE_NAME=Toko Saya
# STORE_ADDRESS=Jl. Merdeka No. 10
# STORE_PHONE=08123456789
# CASHIER_NAME=Kasir

# Optional — printer thermal ESC/POS (butuh paket opsional node-thermal-printer).
# Kosongkan untuk memakai dialog printer bawaan Windows.
# Bentuk yang didukung:
#   192.168.1.10:9100   printer jaringan
#   COM3               printer USB Windows
#   /dev/usb/lp0       printer USB Linux
# PRINTER_PORT=

# Catatan:
# - Aplikasi kasir TIDAK PERLU database server. Semua data toko & transaksi
#   disimpan di SQLite lokal: <userData>/kasir.db
#   Windows : %APPDATA%\KasirPro\kasir.db
# - Tidak ada kredensial Supabase di sisi desktop. Aktivasi cukup memanggil
#   POST <PORTAL_VERCEL_URL>/api/activate dengan { serial_key, hwid }.
