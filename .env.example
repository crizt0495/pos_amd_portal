# ---------------------------------------------------------------------------
# KasirPro - Environment Variables
# Copy to `.env.local` for local development.
# ---------------------------------------------------------------------------

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Server-only key. NEVER expose this to the browser. Used inside API Routes
# (src/app/api/**) to bypass RLS after performing explicit validation.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Public site URL, used for auth redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comfy defaults for the business rules (can be overridden per-store)
NEXT_PUBLIC_DEFAULT_LICENSE_QUOTA=5
NEXT_PUBLIC_APP_NAME=KasirPro
