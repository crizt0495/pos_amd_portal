# ---------------------------------------------------------------------------
# KasirPro Portal — environment variables.
# Salin:  cp .env.example .env.local   (lalu isi nilainya)
# .env.local sudah masuk .gitignore — JANGAN pernah commit kuncinya.
# ---------------------------------------------------------------------------

# --- Supabase (wajib) -------------------------------------------------------
# Nama utama:
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx

# Alias yang juga dibaca (pilih salah satu gaya, jangan isi dua-duanya):
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# --- Supabase (server only, JANGAN pakai prefix NEXT_PUBLIC_) --------------
# Nama utama (gaya baru):
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx
# Alias yang juga dibaca:
# SERVICE_KEY=sb_secret_xxxxxxxxx
# Gaya lama (JWT) — boleh dipakai sebagai alternatif
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5c...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5c...

# --- Aplikasi ---------------------------------------------------------------
# URL publik portal (juga jadi Allowed Origin untuk panggilan dari desktop)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nama aplikasi (title + manifest PWA)
NEXT_PUBLIC_APP_NAME=KasirPro Portal

# Catatan:
# - SUPABASE_SECRET_KEY hanya dipakai di Route Handler server (/api/activate).
# - Aplikasi desktop (folder ../desktop) memakai URL portal di atas untuk
#   POST /api/activate — pastikan URL portal bisa diakses HTTPS dari komputer kasir.
